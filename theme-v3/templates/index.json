    "section_compare": {
      "type": "custom-liquid",
      "name": "Comparison",
      "settings": {
        "custom_liquid": "<div class=\"gomu-cmp\">\n  <div class=\"gomu-cmp__head\">\n    <p class=\"gomu-cmp__eyebrow\">THE JUICY TRUTH</p>\n    <h2 class=\"gomu-cmp__title\">Gummies &gt; pills &gt; powders</h2>\n  </div>\n  <div class=\"gomu-cmp__scroll\">\n    <table class=\"gomu-cmp__table\">\n      <thead>\n        <tr>\n          <th></th>\n          <th class=\"gomu-cmp__gomu-col gomu-cmp__gomu-top\">GOMU</th>\n          <th>Pills</th>\n          <th>Powders</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr><td>Actually tastes amazing</td><td class=\"gomu-cmp__gomu-col\"><span class=\"gomu-cmp__yes\">✓</span></td><td><span class=\"gomu-cmp__no\">✕</span></td><td><span class=\"gomu-cmp__no\">✕</span></td></tr>\n        <tr><td>All-in-one formula (vitamins + minerals + fiber)</td><td class=\"gomu-cmp__gomu-col\"><span class=\"gomu-cmp__yes\">✓</span></td><td><span class=\"gomu-cmp__no\">✕</span></td><td><span class=\"gomu-cmp__yes gomu-cmp__yes--muted\">✓</span></td></tr>\n        <tr><td>No water, no prep, no mess</td><td class=\"gomu-cmp__gomu-col\"><span class=\"gomu-cmp__yes\">✓</span></td><td><span class=\"gomu-cmp__no\">✕</span></td><td><span class=\"gomu-cmp__no\">✕</span></td></tr>\n        <tr><td>One grab-and-go daily sachet</td><td class=\"gomu-cmp__gomu-col\"><span class=\"gomu-cmp__yes\">✓</span></td><td><span class=\"gomu-cmp__no\">✕</span></td><td><span class=\"gomu-cmp__no\">✕</span></td></tr>\n        <tr><td>Vegan &amp; Halal</td><td class=\"gomu-cmp__gomu-col\"><span class=\"gomu-cmp__yes\">✓</span></td><td><span class=\"gomu-cmp__maybe\">varies</span></td><td><span class=\"gomu-cmp__maybe\">varies</span></td></tr>\n        <tr><td>You actually look forward to it</td><td class=\"gomu-cmp__gomu-col gomu-cmp__gomu-bottom\"><span class=\"gomu-cmp__yes\">✓</span></td><td><span class=\"gomu-cmp__no\">✕</span></td><td><span class=\"gomu-cmp__no\">✕</span></td></tr>\n      </tbody>\n    </table>\n  </div>\n</div>\n<style>\n.gomu-cmp{max-width:920px;margin:0 auto;padding:72px 20px}\n.gomu-cmp__head{text-align:center;margin-bottom:36px}\n.gomu-cmp__eyebrow{font-family:var(--font-subheading--family);font-size:.75rem;letter-spacing:.14em;color:#4C9E16;margin:0 0 10px;font-weight:600}\n.gomu-cmp__title{font-family:var(--font-heading--family);font-weight:700;color:#1C2A12;margin:0;font-size:clamp(1.8rem,4vw,2.75rem);line-height:1.1}\n.gomu-cmp__scroll{overflow-x:auto;-webkit-overflow-scrolling:touch}\n.gomu-cmp__table{width:100%;min-width:560px;border-collapse:separate;border-spacing:0;font-family:var(--font-body--family);color:#1C2A12}\n.gomu-cmp__table th{font-family:var(--font-subheading--family);font-size:.8rem;letter-spacing:.1em;text-transform:uppercase;padding:14px 12px;text-align:center}\n.gomu-cmp__table td{padding:16px 12px;border-bottom:1px solid #E7E0CC;font-size:.95rem;text-align:center}\n.gomu-cmp__table td:first-child{text-align:left;font-weight:500}\n.gomu-cmp__table tr:last-child td{border-bottom:none}\n.gomu-cmp__gomu-col{background:#5CB01F;color:#FFF6E3 !important;font-weight:700}\nth.gomu-cmp__gomu-col{font-size:.95rem;letter-spacing:.12em}\n.gomu-cmp__gomu-top{border-radius:20px 20px 0 0}\n.gomu-cmp__gomu-bottom{border-radius:0 0 20px 20px}\ntd.gomu-cmp__gomu-col{border-bottom:1px solid rgba(255,246,227,.25)}\n.gomu-cmp__yes{display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:50%;background:#FFF6E3;color:#4C9E16;font-weight:800;font-size:.85rem}\ntd:not(.gomu-cmp__gomu-col) .gomu-cmp__yes{background:#E8F5DC;color:#4C9E16}\n.gomu-cmp__no{display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:50%;background:#F0EDE3;color:#A8A395;font-weight:700;font-size:.75rem}\n.gomu-cmp__maybe{font-size:.8rem;color:#FFF6E3;opacity:.85;font-style:italic}\ntd:not(.gomu-cmp__gomu-col) .gomu-cmp__maybe{color:#A8A395}\n</style>"
      }
