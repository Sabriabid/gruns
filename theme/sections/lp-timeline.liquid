{%- comment -%}
  LP Timeline — port de src/components/lp/LPTimeline.tsx
  Étapes de résultats (blocks "step") le long d'une ligne verticale, image en regard.
{%- endcomment -%}

<style>
  .lp-timeline {
    background: var(--lp-white);
  }

  .lp-timeline__title {
    font-size: 1.875rem;
    font-weight: 700;
    color: var(--lp-purple);
    text-align: center;
    line-height: 1.2;
    margin-bottom: 3rem;
  }

  @media (min-width: 1024px) {
    .lp-timeline__title { font-size: 2.25rem; }
  }

  .lp-timeline__grid {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
  }

  @media (min-width: 1024px) {
    .lp-timeline__grid {
      flex-direction: row;
      gap: 4rem;
    }
  }

  .lp-timeline__steps {
    flex: 1;
    width: 100%;
    position: relative;
  }

  .lp-timeline__line {
    position: absolute;
    left: 1.5rem;
    top: 0;
    bottom: 0;
    width: 2px;
    background: rgba(124, 58, 237, 0.2);
  }

  .lp-timeline__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .lp-timeline__step {
    position: relative;
    display: flex;
    gap: 1.5rem;
  }

  .lp-timeline__num {
    width: 3rem;
    height: 3rem;
    border-radius: 9999px;
    background: var(--lp-purple);
    color: var(--lp-white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.875rem;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }

  .lp-timeline__step .lp-eyebrow {
    letter-spacing: 0.05em;
  }

  .lp-timeline__body {
    padding-top: 0.375rem;
  }

  .lp-timeline__step-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--lp-dark);
    margin-top: 0.25rem;
    margin-bottom: 0.5rem;
  }

  .lp-timeline__desc {
    color: rgba(26, 10, 46, 0.6);
    line-height: 1.625;
  }

  .lp-timeline__media {
    flex: 1;
    width: 100%;
  }

  .lp-timeline__img {
    border-radius: var(--lp-radius-card);
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    width: 100%;
  }
</style>

{%- liquid
  assign img = section.settings.image
-%}

<section class="lp-timeline lp-section">
  <div class="lp-container lp-container--narrow">
    <h2 class="lp-timeline__title" data-lp-reveal="up">{{ section.settings.heading }}</h2>

    <div class="lp-timeline__grid">
      <div class="lp-timeline__steps">
        <div class="lp-timeline__line" aria-hidden="true"></div>

        <ol class="lp-timeline__list">
          {%- for block in section.blocks -%}
            <li
              class="lp-timeline__step"
              data-lp-reveal="up"
              data-lp-delay="{{ forloop.index }}"
              {{ block.shopify_attributes }}
            >
              <span class="lp-timeline__num" aria-hidden="true">{{ forloop.index }}</span>
              <div class="lp-timeline__body">
                {%- if block.settings.period != blank -%}
                  <span class="lp-eyebrow">{{ block.settings.period }}</span>
                {%- endif -%}
                <h3 class="lp-timeline__step-title">{{ block.settings.title }}</h3>
                {%- if block.settings.description != blank -%}
                  <p class="lp-timeline__desc">{{ block.settings.description }}</p>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ol>
      </div>

      <div class="lp-timeline__media" data-lp-reveal="up">
        {%- if img != blank -%}
          {{
            img
            | image_url: width: 1200
            | image_tag:
              widths: '400, 600, 800, 1200',
              sizes: '(min-width: 1024px) 550px, 90vw',
              loading: 'lazy',
              class: 'lp-timeline__img'
          }}
        {%- else -%}
          <img
            src="{{ 'lp-timeline-expectations.jpeg' | asset_img_url: '800x' }}"
            width="800"
            height="800"
            alt="{{ section.settings.heading | escape }}"
            class="lp-timeline__img"
            loading="lazy"
          >
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LP — Timeline",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Ce que tu peux attendre"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Carrée, min. 1000×1000 px. À défaut : visuel de démo du kit."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "settings": [
        {
          "type": "text",
          "id": "period",
          "label": "Période",
          "default": "Semaine 1-2"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Énergie plus stable"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Énergie plus stable, digestion qui s’améliore. Les premiers effets se font sentir dès les premiers jours."
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "LP — Timeline",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "period": "Semaine 1-2",
            "title": "Énergie plus stable",
            "description": "Énergie plus stable, digestion qui s’améliore. Les premiers effets se font sentir dès les premiers jours."
          }
        },
        {
          "type": "step",
          "settings": {
            "period": "Mois 1-2",
            "title": "Résultats visibles",
            "description": "Sommeil plus réparateur, stress mieux géré, vitalité générale en hausse. Tu sens la différence."
          }
        },
        {
          "type": "step",
          "settings": {
            "period": "Mois 3+",
            "title": "Transformation durable",
            "description": "Résultats mesurables (bilan sanguin), peau/cheveux/ongles. Les bénéfices s’accumulent."
          }
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["page", "product"]
  }
}
{% endschema %}
