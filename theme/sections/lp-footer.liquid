          "id": "url",
          "label": "URL",
          "default": "/pages/lp-digestion"
        }
      ]
    },
    {
      "type": "legal_link",
      "name": "Lien légal",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Libellé",
          "default": "Mentions légales"
        },
        {
          "type": "text",
          "id": "url",
          "label": "URL",
          "default": "#"
        }
