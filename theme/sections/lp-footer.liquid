    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Nutrition quotidienne complète, fabriquée en France."
    },
    {
      "type": "text",
      "id": "nav_heading",
      "label": "Titre de la navigation",
      "default": "Toutes les pages"
    }
  ],
  "blocks": [
    {
      "type": "lp_link",
