{%- comment -%}
  LP FAQ — port de src/components/lp/LPFAQ.tsx + src/components/ui/Accordion.tsx
  Accordéon 100 % natif : <details name="lp-faq"> (exclusivité native, zéro JS).
  Ouverture animée via ::details-content + interpolate-size quand le navigateur
  le supporte ; sinon ouverture instantanée (fallback OK).
{%- endcomment -%}

<style>
  .lp-faq {
    background: var(--lp-cream);
  }

  .lp-faq__grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (min-width: 1024px) {
    .lp-faq__grid {
      flex-direction: row;
      gap: 3rem;
    }
  }

  @media (min-width: 1024px) {
    .lp-faq__heading {
      width: 33.3333%;
      flex-shrink: 0;
    }
  }

  .lp-faq__title {
    font-size: clamp(2.25rem, 1.5rem + 2.8vw, 3.75rem);
    font-weight: 600;
    color: var(--lp-purple-deep);
  }

  .lp-faq__list {
    flex: 1;
    width: 100%;
  }

  .lp-faq__item {
    border-bottom: 1px solid rgba(0, 44, 23, 0.15);
  }

  .lp-faq__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-block: 1.25rem;
    cursor: pointer;
    list-style: none;
  }

  .lp-faq__summary::-webkit-details-marker {
    display: none;
  }

  .lp-faq__question {
    font-size: 1rem;
    font-weight: 700;
    color: var(--lp-dark);
    padding-right: 0.5rem;
  }

  @media (min-width: 640px) {
    .lp-faq__question {
      font-size: 1.125rem;
      padding-right: 1rem;
    }
  }

  .lp-faq__icon {
    display: inline-flex;
    flex-shrink: 0;
    color: var(--lp-purple-accent);
  }

  /* + devient − : la barre verticale du plus s'efface à l'ouverture. */
  .lp-faq__icon svg path {
    transition: opacity 0.2s;
  }

  .lp-faq__item[open] .lp-faq__icon svg path:last-child {
    opacity: 0;
  }

  .lp-faq__answer {
    color: var(--lp-text-muted);
    line-height: 1.625;
    padding-bottom: 1.25rem;
  }

  .lp-faq__answer p + p {
    margin-top: 0.75rem;
  }

  /* Enhancement doux : ouverture animée si supportée, instantanée sinon. */
  @supports (interpolate-size: allow-keywords) {
    .lp-faq__item {
      interpolate-size: allow-keywords;
    }

    .lp-faq__item::details-content {
      block-size: 0;
      overflow: hidden;
      transition: block-size 0.3s ease-in-out, content-visibility 0.3s allow-discrete;
    }

    .lp-faq__item[open]::details-content {
      block-size: auto;
    }
  }

  .lp-faq__cta {
    margin-top: 2rem;
    text-align: center;
  }

  @media (min-width: 1024px) {
    .lp-faq__cta { text-align: left; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lp-faq__icon svg path {
      transition: none;
    }

    .lp-faq__item::details-content {
      transition: none;
    }
  }
</style>

<section class="lp-faq lp-section">
  <div class="lp-container lp-container--tight">
    <div class="lp-faq__grid">
      <div class="lp-faq__heading" data-lp-reveal="up">
        <h2 class="lp-faq__title">{{ section.settings.heading }}</h2>
      </div>

      <div class="lp-faq__list" data-lp-reveal="up" data-lp-delay="1">
        {%- for block in section.blocks -%}
          <details class="lp-faq__item" name="lp-faq-{{ section.id }}" {{ block.shopify_attributes }}>
            <summary class="lp-faq__summary">
              <span class="lp-faq__question">{{ block.settings.question }}</span>
              <span class="lp-faq__icon" aria-hidden="true">
                {% render 'lp-icon', icon: 'plus', size: 24 %}
              </span>
            </summary>
            <div class="lp-faq__answer">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}

        {%- if section.settings.cta_label != blank -%}
          <div class="lp-faq__cta">
            <a href="{{ section.settings.cta_link | default: '#buy-box' }}" class="lp-btn">
              {{- section.settings.cta_label -}}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LP — FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Questions fréquentes"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA de fin de FAQ",
      "info": "Vide = pas de bouton.",
      "default": "Voir l’offre"
    },
    {
      "type": "text",
      "id": "cta_link",
      "label": "Lien du CTA",
      "default": "#buy-box"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Comment ça marche ?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Réponse",
          "default": "<p>Réponse affichée quand la question est dépliée.</p>"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "LP — FAQ",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "C’est juste des bonbons déguisés en compléments ?",
            "answer": "<p>Non. Chaque actif est dosé à un niveau clinique documenté et vérifié par des analyses Eurofins indépendantes, publiées lot par lot. Les formes utilisées (zinc bisglycinate, L-5-MTHF, méthylcobalamine…) sont choisies pour leur biodisponibilité, pas pour le goût.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Un seul produit peut vraiment remplacer 5 compléments ?",
            "answer": "<p>Oui, pour les bases quotidiennes : vitamines, minéraux clés, adaptogènes, prébiotiques. Gomu couvre l’essentiel en un seul geste. On ne prétend pas remplacer un traitement médical spécifique — mais pour la supplémentation de fond, un seul produit bien formulé vaut mieux que 5 sous-dosés.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "C’est halal ?",
            "answer": "<p>Oui, nativement. La base est en pectine de fruit (pas de gélatine bovine ou porcine). C’est conçu comme ça dès le départ, pas adapté après coup. Tu peux vérifier la liste d’ingrédients sur les analyses de chaque lot.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Comment ça marche l’abonnement ?",
            "answer": "<p>Tu reçois ta boîte chaque mois. Tu modifies, pauses ou annules en 2 clics depuis ton compte. Zéro engagement, zéro justification à donner. C’est aussi simple que ça.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Où c’est fabriqué ?",
            "answer": "<p>En France, par un façonnier français certifié. Matières premières tracées, contrôle qualité en labo français, analyses Eurofins lot par lot.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Il y a du sucre dedans ?",
            "answer": "<p>Les gummies contiennent une quantité minime de sucre nécessaire au format gummy (environ 2g par portion). Pas de sucre ajouté superflu, pas d’édulcorants artificiels. Le détail exact est indiqué sur chaque lot.</p>"
          }
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["page", "product"]
  }
}
{% endschema %}
