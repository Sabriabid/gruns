{%- comment -%}
  LP Témoignages — nouveau module (parité Grüns, pas de source React).
  Grille de cartes d'avis clients : étoiles, citation en guillemets français,
  auteur + détail. Stagger data-lp-delay par colonne.
{%- endcomment -%}

<style>
  .lp-testimonials {
    background: var(--lp-white);
  }

  .lp-testimonials__header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .lp-testimonials__title {
    font-size: 1.875rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--lp-dark);
    margin-bottom: 0.75rem;
  }

  @media (min-width: 1024px) {
    .lp-testimonials__title { font-size: 2.25rem; }
  }

  .lp-testimonials__subtitle {
    font-size: 1rem;
    color: rgba(26, 10, 46, 0.6);
  }

  @media (min-width: 640px) {
    .lp-testimonials__subtitle { font-size: 1.125rem; }
  }

  .lp-testimonials__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .lp-testimonials__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .lp-testimonials__grid { grid-template-columns: repeat(3, 1fr); }
  }

  .lp-testimonials__card {
    display: flex;
    flex-direction: column;
    background: var(--lp-cream);
    border-radius: 1rem;
    padding: 2rem;
    margin: 0;
  }

  .lp-testimonials__stars {
    margin-bottom: 1rem;
  }

  .lp-testimonials__quote {
    flex: 1;
    font-size: 0.9375rem;
    line-height: 1.625;
    color: rgba(26, 10, 46, 0.8);
    margin: 0 0 1.25rem;
  }

  .lp-testimonials__author {
    display: block;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--lp-dark);
  }

  .lp-testimonials__detail {
    display: block;
    font-size: 0.75rem;
    color: var(--lp-text-muted);
    margin-top: 0.125rem;
  }
</style>

<section class="lp-testimonials lp-section">
  <div class="lp-container">
    <div class="lp-testimonials__header" data-lp-reveal="up">
      <h2 class="lp-testimonials__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="lp-testimonials__subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="lp-testimonials__grid">
      {%- for block in section.blocks -%}
        {%- assign delay = forloop.index0 | modulo: 3 -%}
        <figure
          class="lp-testimonials__card"
          data-lp-reveal="up"
          {% if delay > 0 %}data-lp-delay="{{ delay }}"{% endif %}
          {{ block.shopify_attributes }}
        >
          <div class="lp-testimonials__stars" aria-hidden="true">
            {% render 'lp-stars', size: 16, count: block.settings.rating %}
          </div>
          <span class="lp-visually-hidden">{{ block.settings.rating }} étoiles sur 5</span>

          <blockquote class="lp-testimonials__quote">
            «&nbsp;{{ block.settings.quote }}&nbsp;»
          </blockquote>

          <figcaption>
            <span class="lp-testimonials__author">{{ block.settings.author }}</span>
            {%- if block.settings.detail != blank -%}
              <span class="lp-testimonials__detail">{{ block.settings.detail }}</span>
            {%- endif -%}
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LP — Témoignages",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Ils ont adopté Gomu"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "Des avis vérifiés, par des gens comme toi."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Témoignage",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Avis",
          "default": "[Avis client à remplacer] Décris un bénéfice concret ressenti par le client, avec ses mots."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Auteur",
          "default": "[Prénom]"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Détail (ex. Cliente vérifiée)",
          "default": "Cliente vérifiée"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Note",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [
    {
      "name": "LP — Témoignages",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "[Avis client à remplacer] Décris un bénéfice concret ressenti par le client, avec ses mots.",
            "author": "[Prénom]",
            "detail": "Cliente vérifiée",
            "rating": 5
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "[Avis client à remplacer] Par exemple : la simplicité du geste quotidien, le goût, l’effet ressenti.",
            "author": "[Prénom]",
            "detail": "Cliente vérifiée",
            "rating": 5
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "[Avis client à remplacer] Par exemple : pourquoi il ou elle a remplacé ses pots de compléments.",
            "author": "[Prénom]",
            "detail": "Client vérifié",
            "rating": 5
          }
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["page", "product"]
  }
}
{% endschema %}
