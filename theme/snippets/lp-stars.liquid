{%- comment -%}
  Étoiles (jaune brand), équivalent du StarRating du prototype.
  Usage : {% render 'lp-stars', size: 16 %}            → 5 pleines
          {% render 'lp-stars', size: 16, count: 4 %}  → 4 pleines + 1 grise
{%- endcomment -%}
{%- liquid
  assign size = size | default: 16
  assign count = count | default: 5
-%}
<span class="lp-stars" aria-hidden="true">
  {%- for i in (1..5) -%}
    <svg xmlns="http://www.w3.org/2000/svg" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false" {% if i > count %}style="color: #d1d5db; fill: none;"{% endif %}><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
  {%- endfor -%}
</span>
