<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f8f5ff">
    <meta name="robots" content="noindex, nofollow">

    <title>{{ page_title }}</title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    <meta property="og:title" content="{{ page_title | escape }}">
    {%- if page_description -%}
      <meta property="og:description" content="{{ page_description | escape }}">
    {%- endif -%}
    <meta property="og:type" content="website">
    <meta property="og:locale" content="fr_FR">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- comment -%}
      Le préchargement de l'image héro (LCP) est fait par la section lp-hero
      elle-même via le filtre preload_tag (émet un header Link, position indifférente).
    {%- endcomment -%}

    {{ 'lp-base.css' | asset_url | stylesheet_tag }}

    <script>document.documentElement.classList.remove('no-js');</script>

    {{ content_for_header }}
  </head>

  <body class="lp-body">
    {{ content_for_layout }}

    <script src="{{ 'lp.js' | asset_url }}" defer></script>
  </body>
</html>
