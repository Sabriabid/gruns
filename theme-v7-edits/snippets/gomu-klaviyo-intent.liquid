{%- comment -%}
  Pont entre la popup « Intent quiz » (RmpRJE) et le profil Klaviyo.

  POURQUOI CE FICHIER EXISTE
  La popup pose l'angle à l'étape 1 et l'e-mail à l'étape 2. Klaviyo ne sait pas
  transporter le choix : les champs masqués d'un bouton ne partent qu'avec SA
  soumission, or l'étape 1 n'a pas de champ e-mail donc aucun profil n'est créé ;
  et le menu « Après l'envoi » n'offre que étape-suivante / URL / fermer, donc on
  ne peut pas donner à chaque angle son propre écran e-mail.

  CE QUI A ÉTÉ MESURÉ (2026-08-23, en production)
  - klaviyo.identify() et _learnq.push(['identify', …]) n'écrivent PAS les
    propriétés personnalisées. Échec silencieux. Seule l'API Client publique
    écrit réellement (202 + propriété visible dans la seconde).
  - L'écouteur de clic au niveau document fonctionne, lui, de façon fiable.
  - En revanche l'événement klaviyoForms 'submit' n'est pas un point d'accroche
    sûr : au moment où il arrive, Klaviyo a déjà remplacé l'étape 2 par l'écran
    de succès, et le champ e-mail a quitté le DOM.

  D'OÙ CE DESIGN
  On s'appuie uniquement sur ce qui est prouvé : le clic. L'angle est mémorisé
  au clic sur son bouton, l'e-mail est lu pendant la frappe, et l'écriture part
  au clic sur le bouton d'envoi — donc EN MÊME TEMPS que la soumission Klaviyo,
  et non après. La propriété est ainsi présente quand le flow évalue son split,
  ce qui permet de supprimer le délai et d'envoyer l'e-mail tout de suite.
{%- endcomment -%}
<script>
  (function () {
    var FORM_ID = 'RmpRJE';
    var COMPANY_ID = 'SLn2Z2';

    /* Fragment de libellé -> valeur attendue par le split du flow Rzv8Mj. */
    var ANGLES = [
      ['GLP-1', 'glp1'],
      ['easy nutrition', 'all_in_one'],
      ['gut health', 'digestion'],
      ['afternoon slump', 'energy'],
      ['show me the basics', 'not_said']
    ];

    var angle = null;
    var email = null;
    var written = false;

    try { angle = sessionStorage.getItem('gomu_intention') || null; } catch (e) {}

    function trace(step, extra) {
      try {
        var log = JSON.parse(sessionStorage.getItem('gomu_debug') || '[]');
        log.push({ t: Date.now(), step: step, angle: angle, email: !!email, x: extra || null });
        sessionStorage.setItem('gomu_debug', JSON.stringify(log.slice(-25)));
      } catch (e) {}
    }

    function inForm(el) {
      return !!(el && ((el.classList && el.classList.contains('klaviyo-form-button')) ||
                       (el.closest && el.closest('[class*="kl-private"]'))));
    }

    /* L'e-mail, pendant la frappe : au moment du clic d'envoi il est encore là,
       mais l'écran de succès le fait disparaître juste après. */
    function grabEmail(ev) {
      var el = ev.target;
      if (!el || el.tagName !== 'INPUT') return;
      var looksEmail = el.type === 'email' ||
                       /email/i.test(el.name || el.getAttribute('placeholder') || '');
      if (!looksEmail) return;
      var v = (el.value || '').trim();
      if (v.indexOf('@') > 0) email = v;
    }
    document.addEventListener('input', grabEmail, true);
    document.addEventListener('change', grabEmail, true);

    /* Écriture via l'API Client publique. Idempotente. */
    function write(why) {
      if (written || !angle || !email) { trace('skip:' + why); return; }
      written = true;
      trace('write:' + why);
      fetch('https://a.klaviyo.com/client/profiles/?company_id=' + COMPANY_ID, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'revision': '2024-10-15' },
        body: JSON.stringify({ data: { type: 'profile', attributes: {
          email: email,
          properties: { gomu_intention: angle, gomu_source: 'popup_sitewide' }
        }}}),
        keepalive: true
      }).then(function (r) {
        trace('done', r.status);
        if (r.ok) { try { sessionStorage.removeItem('gomu_intention'); } catch (e) {} }
        else { written = false; }
      }).catch(function (e) { written = false; trace('error', String(e)); });
    }

    /* Un seul écouteur pour les deux rôles : mémoriser l'angle, puis déclencher
       l'écriture au clic d'envoi. C'est le mécanisme dont la fiabilité est
       vérifiée ; tout le reste n'est que filet de sécurité. */
    document.addEventListener('click', function (ev) {
      var btn = ev.target && ev.target.closest ? ev.target.closest('button') : null;
      if (!btn || !inForm(btn)) return;
      var label = (btn.textContent || '').trim();
      if (!label) return;

      for (var i = 0; i < ANGLES.length; i++) {
        if (label.indexOf(ANGLES[i][0]) !== -1) {
          angle = ANGLES[i][1];
          try { sessionStorage.setItem('gomu_intention', angle); } catch (e) {}
          trace('angle');
          return;
        }
      }
      /* Tout autre bouton du formulaire après un angle : c'est l'envoi. */
      if (angle) write('click');
    }, true);

    /* Filets de sécurité, au cas où le clic d'envoi passerait autrement. */
    document.addEventListener('klaviyoForms', function (ev) {
      var d = ev.detail || {};
      if (d.formId !== FORM_ID) return;
      var meta = d.metaData || {};
      if (meta.gomu_intention) angle = meta.gomu_intention;
      if (meta.$email || meta.email) email = meta.$email || meta.email;
      trace('evt:' + d.type);
      if (d.type === 'submit' || d.type === 'stepSubmit') write(d.type);
    });
  })();
</script>
