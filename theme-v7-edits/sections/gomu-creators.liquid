{% render 'gomu-base' %}
{%- comment -%}
  GOMU — page créateurs de contenu.

  Formulaire de contact natif Shopify : tout champ nommé contact[Titre] est
  repris tel quel dans l'e-mail de notification, avec son nom comme libellé.
  Seul contact[email] est obligatoire (contrainte Shopify) ; contact[body]
  devient le corps du message. D'où les noms ASCII sans accent.

  La balise form enveloppe TOUTE la section, pas seulement les champs : l'objet
  form n'existe qu'à l'intérieur de la balise, et c'est la seule façon de rendre
  le panneau de confirmation au-dessus du titre. Sinon il se retrouve à ~900px
  du haut, sous le pli, et la transition de page d'Horizon écrase tout scroll
  programmatique déclenché au chargement.
{%- endcomment -%}
{%- assign form_id = 'gomu-creators-form-' | append: section.id -%}

<style>
  #gomu-creators-{{ section.id }} { background:var(--cream); padding:clamp(56px,7vw,104px) 0 clamp(64px,8vw,116px); }
  #gomu-creators-{{ section.id }} .gc-head { display:flex; flex-direction:column; gap:16px; max-width:720px; margin-bottom:clamp(36px,4.5vw,60px); }
  #gomu-creators-{{ section.id }} .gc-head .gomu-mono { color:var(--mute); letter-spacing:.22em; }
  #gomu-creators-{{ section.id }} h1 { font-size:clamp(34px,4.6vw,62px); font-weight:800; line-height:1; }
  #gomu-creators-{{ section.id }} .gc-sub { font-size:17px; line-height:1.6; color:var(--ink2); max-width:600px; }

  #gomu-creators-{{ section.id }} .gc-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:clamp(14px,1.8vw,22px); margin-bottom:clamp(44px,5.5vw,76px); }
  #gomu-creators-{{ section.id }} .gc-card { display:flex; flex-direction:column; gap:12px; background:var(--cream2); border:1px solid var(--line); border-radius:22px; padding:clamp(22px,2.4vw,30px); }
  #gomu-creators-{{ section.id }} .gc-ico { width:46px; height:46px; border-radius:50%; background:var(--mint); display:flex; align-items:center; justify-content:center; font-size:22px; line-height:1; }
  #gomu-creators-{{ section.id }} .gc-card h3 { font-size:20px; font-weight:700; letter-spacing:-.02em; }
  #gomu-creators-{{ section.id }} .gc-card p { font-size:15.5px; line-height:1.6; color:var(--ink2); }

  #gomu-creators-{{ section.id }} .gc-panel { max-width:760px; background:var(--cream2); border:1px solid var(--line); border-radius:26px; padding:clamp(24px,3.2vw,44px); scroll-margin-top:calc(var(--header-group-height, 90px) + 24px); }
  #gomu-creators-{{ section.id }} .gc-panel h2 { font-size:clamp(24px,2.6vw,34px); font-weight:700; line-height:1.05; margin-bottom:6px; }
  #gomu-creators-{{ section.id }} .gc-panel-sub { font-size:15.5px; line-height:1.6; color:var(--ink2); margin-bottom:26px; }

  #gomu-creators-{{ section.id }} .gc-fields { display:flex; flex-direction:column; gap:18px; }
  #gomu-creators-{{ section.id }} .gc-row { display:grid; grid-template-columns:1fr; gap:18px; }
  @media (min-width:640px) { #gomu-creators-{{ section.id }} .gc-row--2 { grid-template-columns:1fr 1fr; } }
  #gomu-creators-{{ section.id }} .gc-field { display:flex; flex-direction:column; gap:7px; min-width:0; }
  #gomu-creators-{{ section.id }} label { font-size:13.5px; font-weight:600; letter-spacing:-.005em; color:var(--ink); }
  #gomu-creators-{{ section.id }} label span { color:var(--deep); }
  #gomu-creators-{{ section.id }} .gc-opt { font-weight:400; color:var(--mute); }
  #gomu-creators-{{ section.id }} input, #gomu-creators-{{ section.id }} textarea {
    width:100%; max-width:100%; font-family:inherit; font-size:15.5px; color:var(--ink);
    background:#fff; border:1px solid var(--line); border-radius:12px; padding:13px 15px;
    transition:border-color .16s, box-shadow .16s; -webkit-appearance:none; appearance:none; }
  #gomu-creators-{{ section.id }} textarea { min-height:132px; resize:vertical; line-height:1.55; }
  #gomu-creators-{{ section.id }} input::placeholder, #gomu-creators-{{ section.id }} textarea::placeholder { color:#B49B90; }
  #gomu-creators-{{ section.id }} input:focus, #gomu-creators-{{ section.id }} textarea:focus {
    outline:none; border-color:var(--deep); box-shadow:0 0 0 3px rgba(134,27,37,.14); }

  #gomu-creators-{{ section.id }} .gc-actions { display:flex; flex-direction:column; gap:14px; align-items:flex-start; margin-top:22px; }
  #gomu-creators-{{ section.id }} .gomu-btn { padding:17px 34px; font-size:16px; }
  #gomu-creators-{{ section.id }} .gc-legal { font-size:13px; line-height:1.55; color:var(--mute); }
  #gomu-creators-{{ section.id }} .gc-legal a { color:var(--deep); text-decoration:underline; text-underline-offset:2px; }
  #gomu-creators-{{ section.id }} .gc-legal p { margin:0; }
  #gomu-creators-{{ section.id }} .gc-note { font-size:14px; color:var(--ink2); margin-top:22px; max-width:760px; }

  #gomu-creators-{{ section.id }} .gc-alert { display:flex; gap:12px; align-items:flex-start; max-width:760px; border-radius:16px; padding:16px 18px; font-size:15px; line-height:1.55; margin-bottom:clamp(28px,3.5vw,44px); }
  #gomu-creators-{{ section.id }} .gc-alert:focus { outline:none; }
  #gomu-creators-{{ section.id }} .gc-alert em { font-style:normal; font-size:18px; line-height:1.3; }
  #gomu-creators-{{ section.id }} .gc-alert--ok { background:rgba(134,27,37,.07); border:1px solid var(--deep); color:var(--ink); }
  #gomu-creators-{{ section.id }} .gc-alert--ko { background:#FCEDED; border:1px solid #A91B23; color:#6E1520; }
  #gomu-creators-{{ section.id }} .gc-alert a { color:inherit; text-decoration:underline; }
</style>

<section class="gomu" id="gomu-creators-{{ section.id }}">
  {%- form 'contact', id: form_id, class: 'gc-form', data-shopify-captcha: 'true' -%}
    <div class="gomu-wrap">
      <input type="hidden" name="contact[id]" value="{{ form_id }}">
      <input type="hidden" name="contact[Origine]" value="Page createurs de contenu">

      {%- liquid
        assign form_matches = false
        if form.id == form_id or form.id == blank
          assign form_matches = true
        endif

        assign posted = false
        if form_matches and form.posted_successfully?
          assign posted = true
        endif

        assign failed = false
        if form_matches and form.errors
          assign failed = true
        endif
      -%}

      {%- if posted -%}
        <div class="gc-alert gc-alert--ok" id="{{ form_id }}-alert" tabindex="-1" role="status">
          <em aria-hidden="true">✓</em>
          <span>{{ section.settings.success_text }}</span>
        </div>
      {%- endif -%}

      {%- if failed -%}
        <div class="gc-alert gc-alert--ko" id="{{ form_id }}-alert" tabindex="-1" role="alert">
          <em aria-hidden="true">!</em>
          <span>{{ form.errors | default_errors }}</span>
        </div>
      {%- endif -%}

      {%- if posted or failed -%}
        {%- comment -%} Le panneau est déjà en haut : on ne fait que porter le focus, sans scroll. {%- endcomment -%}
        <script>
          (function () {
            var el = document.getElementById({{ form_id | json }} + '-alert');
            if (el) el.focus({ preventScroll: true });
          })();
        </script>
      {%- endif -%}

      <div class="gc-head">
        {%- if section.settings.eyebrow != blank -%}<span class="gomu-mono">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h1>{{ section.settings.heading }}</h1>
        {%- if section.settings.subheading != blank -%}<p class="gc-sub">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="gc-grid">
          {%- for block in section.blocks -%}
            <article class="gc-card" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}<div class="gc-ico" aria-hidden="true">{{ block.settings.icon }}</div>{%- endif -%}
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </article>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="gc-panel">
        <h2>{{ section.settings.form_heading }}</h2>
        {%- if section.settings.form_subheading != blank -%}<p class="gc-panel-sub">{{ section.settings.form_subheading }}</p>{%- endif -%}

        <div class="gc-fields">
          <div class="gc-field">
            <label for="{{ form_id }}-email">E-mail <span aria-hidden="true">*</span></label>
            <input
              type="email"
              id="{{ form_id }}-email"
              name="contact[email]"
              autocomplete="email"
              inputmode="email"
              spellcheck="false"
              autocapitalize="off"
              required
              aria-required="true"
              {% if failed and form.errors contains 'email' %}aria-invalid="true"{% endif %}
              placeholder="toi@exemple.com"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            >
          </div>

          <div class="gc-row gc-row--2">
            <div class="gc-field">
              <label for="{{ form_id }}-name">Nom ou pseudo <span class="gc-opt">— facultatif</span></label>
              <input type="text" id="{{ form_id }}-name" name="contact[Nom]" autocomplete="name" placeholder="Comment on t'appelle ?">
            </div>
            <div class="gc-field">
              <label for="{{ form_id }}-city">Ville / pays <span class="gc-opt">— facultatif</span></label>
              <input type="text" id="{{ form_id }}-city" name="contact[Ville]" autocomplete="address-level2" placeholder="Paris, France">
            </div>
          </div>

          <div class="gc-row gc-row--2">
            <div class="gc-field">
              <label for="{{ form_id }}-ig">Instagram <span class="gc-opt">— facultatif</span></label>
              <input type="text" id="{{ form_id }}-ig" name="contact[Instagram]" spellcheck="false" autocapitalize="off" placeholder="@tonpseudo">
            </div>
            <div class="gc-field">
              <label for="{{ form_id }}-tt">TikTok <span class="gc-opt">— facultatif</span></label>
              <input type="text" id="{{ form_id }}-tt" name="contact[TikTok]" spellcheck="false" autocapitalize="off" placeholder="@tonpseudo">
            </div>
          </div>

          <div class="gc-row gc-row--2">
            <div class="gc-field">
              <label for="{{ form_id }}-snap">Snapchat <span class="gc-opt">— facultatif</span></label>
              <input type="text" id="{{ form_id }}-snap" name="contact[Snapchat]" spellcheck="false" autocapitalize="off" placeholder="@tonpseudo">
            </div>
            <div class="gc-field">
              <label for="{{ form_id }}-yt">YouTube <span class="gc-opt">— facultatif</span></label>
              <input type="text" id="{{ form_id }}-yt" name="contact[YouTube]" spellcheck="false" autocapitalize="off" placeholder="@tachaine">
            </div>
          </div>

          <div class="gc-field">
            <label for="{{ form_id }}-body">{{ section.settings.message_label }} <span class="gc-opt">— facultatif</span></label>
            <textarea id="{{ form_id }}-body" name="contact[body]" rows="6" placeholder="{{ section.settings.message_placeholder | escape }}">{{ form.body }}</textarea>
          </div>
        </div>

        <div class="gc-actions">
          <button type="submit" class="gomu-btn gomu-btn--deep">{{ section.settings.submit_label }}</button>
          {%- if section.settings.legal != blank -%}<div class="gc-legal">{{ section.settings.legal }}</div>{%- endif -%}
        </div>
      </div>

      {%- if section.settings.footnote != blank -%}<p class="gc-note">{{ section.settings.footnote }}</p>{%- endif -%}
    </div>
  {%- endform -%}
</section>

{% schema %}
{
  "name": "GOMU créateurs",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Programme créateurs" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Tu crées du contenu ? On bosse avec toi." },
    { "type": "textarea", "id": "subheading", "label": "Sous-titre", "default": "Gomu cherche des créateurs qui parlent vrai. Pas de brief à rallonge, pas de script imposé : tu testes, tu donnes ton avis, on construit la suite ensemble." },
    { "type": "header", "content": "Formulaire" },
    { "type": "text", "id": "form_heading", "label": "Titre du formulaire", "default": "Postuler" },
    { "type": "textarea", "id": "form_subheading", "label": "Sous-titre du formulaire", "default": "Laisse-nous ton e-mail et les réseaux sur lesquels tu es actif. Tout le reste est facultatif." },
    { "type": "text", "id": "message_label", "label": "Libellé du message", "default": "Parle-nous de toi" },
    { "type": "text", "id": "message_placeholder", "label": "Placeholder du message", "default": "Ce que tu crées, ton audience, ce que tu aimerais faire avec nous. Dis-nous tout — on lit chaque message." },
    { "type": "text", "id": "submit_label", "label": "Libellé du bouton", "default": "Envoyer ma candidature" },
    { "type": "richtext", "id": "legal", "label": "Mention sous le bouton", "default": "<p>On utilise ces infos uniquement pour te répondre. Aucune inscription à la newsletter.</p>" },
    { "type": "text", "id": "success_text", "label": "Message de confirmation", "default": "Merci, on a bien reçu ta candidature. On revient vers toi sous 48h ouvrées." },
    { "type": "text", "id": "footnote", "label": "Note de bas de section", "default": "Réponse sous 48h ouvrées, du lundi au vendredi. Pas de bot : c'est nous qui lisons." }
  ],
  "blocks": [
    { "type": "benefit", "name": "Bénéfice", "limit": 4, "settings": [
      { "type": "text", "id": "icon", "label": "Emoji", "default": "🎁" },
      { "type": "text", "id": "title", "label": "Titre", "default": "Un pack offert" },
      { "type": "textarea", "id": "text", "label": "Texte", "default": "On t'envoie Gomu Daily pour que tu le testes vraiment avant d'en parler." }
    ] }
  ],
  "presets": [
    { "name": "GOMU créateurs", "blocks": [
      { "type": "benefit", "settings": { "icon": "🎁", "title": "Un pack offert", "text": "On t'envoie Gomu Daily pour que tu le testes vraiment avant d'en parler." } },
      { "type": "benefit", "settings": { "icon": "💸", "title": "Un code affilié", "text": "Ton code perso, une remise pour ta communauté, une commission sur chaque commande." } },
      { "type": "benefit", "settings": { "icon": "📣", "title": "On te repost", "text": "Tes contenus sur nos réseaux et nos pubs, avec ton crédit. Ton travail circule." } }
    ] }
  ],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
