{% render 'gomu-base' %}
<style>
  #gomu-faq-{{ section.id }} { background:var(--cream); padding:0 0 clamp(64px,8vw,116px); scroll-margin-top:90px; }
  #gomu-faq-{{ section.id }} .gf-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:clamp(26px,4vw,60px); }
  #gomu-faq-{{ section.id }} .gomu-mono { color:var(--mute); letter-spacing:.22em; }
  #gomu-faq-{{ section.id }} h2 { font-size:clamp(28px,3.2vw,44px); font-weight:800; line-height:1.02; }
  #gomu-faq-{{ section.id }} .gf-intro p { font-size:15.5px; line-height:1.6; color:var(--ink2); max-width:320px; }
  #gomu-faq-{{ section.id }} .gf-intro a { color:var(--deep); text-decoration:underline; text-underline-offset:2px; }
  #gomu-faq-{{ section.id }} details { border-top:1px solid var(--line); }
  #gomu-faq-{{ section.id }} details:last-child { border-bottom:1px solid var(--line); }
  #gomu-faq-{{ section.id }} summary { display:flex; justify-content:space-between; align-items:center; gap:18px; padding:21px 0; font-size:17px; font-weight:600; letter-spacing:-.015em; cursor:pointer; list-style:none; }
  #gomu-faq-{{ section.id }} summary::-webkit-details-marker { display:none; }
  #gomu-faq-{{ section.id }} summary em { font-style:normal; color:#9B8177; font-weight:400; transition:transform .2s; }
  #gomu-faq-{{ section.id }} details[open] summary em { transform:rotate(45deg); }
  #gomu-faq-{{ section.id }} .gf-a { font-size:15.5px; line-height:1.65; color:var(--ink2); padding:0 36px 21px 0; }
  #gomu-faq-{{ section.id }} .gf-a p { margin:0 0 10px; }
  #gomu-faq-{{ section.id }} .gf-a p:last-child { margin:0; }
</style>

<section class="gomu" id="gomu-faq-{{ section.id }}">
  <div class="gomu-wrap gomu-anchor" id="gomu-faq">
    <div class="gf-grid">
      <div class="gf-intro" style="display:flex;flex-direction:column;gap:15px">
        {%- if section.settings.eyebrow != blank -%}<span class="gomu-mono">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.body != blank -%}<p>{{ section.settings.body }}</p>{%- endif -%}
      </div>
      <div style="display:flex;flex-direction:column">
        {%- for block in section.blocks -%}
          <details {{ block.shopify_attributes }}>
            <summary>{{ block.settings.q }}<em>+</em></summary>
            <div class="gf-a">{{ block.settings.a }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GOMU FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Good questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything you're wondering." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Still stuck? Write to us and a human answers.</p>" }
  ],
  "blocks": [
    { "type": "qa", "name": "Question", "settings": [
      { "type": "text", "id": "q", "label": "Question", "default": "What exactly is Gomu?" },
      { "type": "richtext", "id": "a", "label": "Answer", "default": "<p>An all-in-one multivitamin in gummies.</p>" }
    ] }
  ],
  "presets": [ { "name": "GOMU FAQ", "blocks": [ { "type": "qa" }, { "type": "qa" }, { "type": "qa" }, { "type": "qa" }, { "type": "qa" } ] } ]
}
{% endschema %}
