{% render 'gomu-base' %}
<style>
  #gomu-vc-{{ section.id }} { background:var(--cream); padding:clamp(64px,8vw,116px) 0; }
  #gomu-vc-{{ section.id }} .gv-head { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:flex-end; gap:20px; margin-bottom:clamp(32px,4vw,52px); }
  #gomu-vc-{{ section.id }} .gv-head h2 { font-size:clamp(32px,4vw,54px); font-weight:800; line-height:1; max-width:600px; }
  #gomu-vc-{{ section.id }} .gv-head p { font-size:16px; line-height:1.6; color:var(--ink2); max-width:320px; }
  #gomu-vc-{{ section.id }} .gv-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(232px,1fr)); gap:clamp(16px,2vw,26px); }
  #gomu-vc-{{ section.id }} article { display:flex; flex-direction:column; gap:18px; }
  #gomu-vc-{{ section.id }} .gv-media { aspect-ratio:4/5; border-radius:22px; overflow:hidden; background:var(--mint); }
  #gomu-vc-{{ section.id }} .gv-media img { width:100%; height:100%; object-fit:cover; display:block; }
  #gomu-vc-{{ section.id }} h3 { font-size:22px; font-weight:700; letter-spacing:-.02em; }
  #gomu-vc-{{ section.id }} article p { font-size:15.5px; line-height:1.6; color:var(--ink2); }
</style>

<section class="gomu" id="gomu-vc-{{ section.id }}">
  <div class="gomu-wrap">
    <div class="gv-head">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}<p>{{ section.settings.body }}</p>{%- endif -%}
    </div>
    <div class="gv-grid">
      {%- for block in section.blocks -%}
        <article {{ block.shopify_attributes }}>
          <div class="gv-media">
            {%- if block.settings.image -%}
              <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.image.alt | escape }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy">
            {%- endif -%}
          </div>
          <div style="display:flex;flex-direction:column;gap:8px">
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GOMU value cards",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "We made daily nutrition ridiculously easy." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Three things had to be true, or nobody keeps the habit." }
  ],
  "blocks": [
    { "type": "card", "name": "Card", "limit": 4, "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "title", "label": "Title", "default": "It tastes like a treat" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Strawberry Raspberry, no chalk, no aftertaste." }
    ] }
  ],
  "presets": [ { "name": "GOMU value cards", "blocks": [ { "type": "card" }, { "type": "card" }, { "type": "card" } ] } ]
}
{% endschema %}
