{% render 'gomu-base' %}
<style>
  #gomu-in-{{ section.id }} { background:var(--deep); padding:clamp(60px,7.5vw,110px) 0; scroll-margin-top:90px; }
  #gomu-in-{{ section.id }} .gi-head { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:flex-end; gap:20px; margin-bottom:clamp(34px,4vw,56px); }
  #gomu-in-{{ section.id }} h2 { font-size:clamp(30px,3.6vw,50px); font-weight:800; line-height:1; color:var(--cream); max-width:540px; }
  #gomu-in-{{ section.id }} .gi-head p { font-size:16px; line-height:1.6; color:rgba(249,227,211,.66); max-width:320px; }
  #gomu-in-{{ section.id }} .gi-grid { display:grid; grid-template-columns:1fr 1fr; gap:clamp(20px,2.6vw,36px); align-items:stretch; }
  #gomu-in-{{ section.id }} .gi-card { border:1px solid rgba(249,227,211,.16); border-radius:24px; overflow:hidden; display:flex; flex-direction:column; }
  #gomu-in-{{ section.id }} .gi-media { flex:1; min-height:0; background:#9C2531; }
  #gomu-in-{{ section.id }} .gi-media img { width:100%; height:100%; object-fit:cover; display:block; }
  #gomu-in-{{ section.id }} .gi-chips { display:grid; grid-template-columns:1fr 1fr; gap:1px; background:rgba(249,227,211,.14); flex:none; }
  #gomu-in-{{ section.id }} .gi-chip { background:var(--deep); padding:18px 20px; display:flex; flex-direction:column; gap:6px; }
  #gomu-in-{{ section.id }} .gi-chip span { font-family:'DM Mono',monospace; font-size:10px; letter-spacing:.18em; text-transform:uppercase; color:rgba(249,227,211,.5); }
  #gomu-in-{{ section.id }} .gi-chip b { font-size:16px; font-weight:600; color:var(--cream); letter-spacing:-.01em; }
  #gomu-in-{{ section.id }} .gi-rows { display:flex; flex-direction:column; gap:1px; background:rgba(249,227,211,.16); border:1px solid rgba(249,227,211,.16); border-radius:24px; overflow:hidden; }
  #gomu-in-{{ section.id }} .gi-row { background:var(--deep); padding:22px 24px; display:grid; grid-template-columns:1fr auto; gap:16px; align-items:center; flex:1 1 0; min-height:64px; }
  #gomu-in-{{ section.id }} .gi-row span { font-size:16px; color:var(--cream); letter-spacing:-.01em; }
  #gomu-in-{{ section.id }} .gi-row b { font-family:'Bricolage Grotesque',sans-serif; font-size:24px; font-weight:800; letter-spacing:-.04em; color:var(--lime); }
  #gomu-in-{{ section.id }} .gi-label { background:#9C2531; padding:0; flex:none; }
  #gomu-in-{{ section.id }} .gi-label img { width:100%; display:block; }
  #gomu-in-{{ section.id }} .gi-note { background:#9C2531; padding:20px 24px; font-family:'DM Mono',monospace; font-size:11px; line-height:1.7; letter-spacing:.05em; color:rgba(249,227,211,.55); flex:none; }
  @media (max-width:1000px) { #gomu-in-{{ section.id }} .gi-grid { grid-template-columns:1fr; } #gomu-in-{{ section.id }} .gi-media { aspect-ratio:16/10; flex:none; } #gomu-in-{{ section.id }} .gi-row { flex:none; } }
  @media (max-width:700px) { #gomu-in-{{ section.id }} .gi-chips { grid-template-columns:1fr; } }
</style>

<section class="gomu" id="gomu-in-{{ section.id }}">
  <div class="gomu-wrap">
    <div class="gi-head">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}<p>{{ section.settings.body }}</p>{%- endif -%}
    </div>
    <div class="gi-grid">
      <div class="gi-card">
        <div class="gi-media">
          {%- if section.settings.image -%}
            <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" loading="lazy">
          {%- endif -%}
        </div>
        <div class="gi-chips">
          <div class="gi-chip"><span>{{ section.settings.chip1_label }}</span><b>{{ section.settings.chip1_value }}</b></div>
          <div class="gi-chip"><span>{{ section.settings.chip2_label }}</span><b>{{ section.settings.chip2_value }}</b></div>
        </div>
      </div>
      <div class="gi-rows">
        {%- for block in section.blocks -%}
          <div class="gi-row" {{ block.shopify_attributes }}>
            <span>{{ block.settings.label }}</span>
            <b>{{ block.settings.value }}</b>
          </div>
        {%- endfor -%}
        {%- if section.settings.label_image -%}
          <div class="gi-label"><img src="{{ section.settings.label_image | image_url: width: 1000 }}" alt="{{ section.settings.label_image.alt | escape }}" width="{{ section.settings.label_image.width }}" height="{{ section.settings.label_image.height }}" loading="lazy"></div>
        {%- elsif request.design_mode -%}
          <div class="gi-note">ADD YOUR NUTRITION LABEL IMAGE IN THIS SECTION'S SETTINGS. THIS NOTE IS ONLY VISIBLE IN THE THEME EDITOR.</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GOMU what's inside",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What's actually in the pack." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "The gummies are deep red because of what goes into them, not what's painted on them." },
    { "type": "image_picker", "id": "image", "label": "Product image" },
    { "type": "text", "id": "chip1_label", "label": "Chip 1 label", "default": "Tastes like" },
    { "type": "text", "id": "chip1_value", "label": "Chip 1 value", "default": "Strawberry Raspberry" },
    { "type": "text", "id": "chip2_label", "label": "Chip 2 label", "default": "Base" },
    { "type": "text", "id": "chip2_value", "label": "Chip 2 value", "default": "Fruit pectin, no gelatin" },
    { "type": "image_picker", "id": "label_image", "label": "Nutrition label image" }
  ],
  "blocks": [
    { "type": "row", "name": "Spec row", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Vitamins & minerals" },
      { "type": "text", "id": "value", "label": "Value", "default": "20+" }
    ] }
  ],
  "presets": [ { "name": "GOMU what's inside", "blocks": [ { "type": "row" }, { "type": "row" }, { "type": "row" }, { "type": "row" }, { "type": "row" } ] } ]
}
{% endschema %}
