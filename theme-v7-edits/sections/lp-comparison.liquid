{%- comment -%}
  LP Comparaison — nouveau module (parité Grüns ; inspiration src/components/v2/Comparatif.tsx).
  Tableau « nous vs eux » : en-têtes de colonnes ≥640px, cartes empilées avec
  mini-labels sur mobile (mini-labels gardés lisibles pour les lecteurs d'écran).
{%- endcomment -%}

<style>
  .lp-comparison {
    background: var(--lp-cream);
  }

  .lp-comparison__heading {
    font-size: clamp(2.25rem, 1.5rem + 2.8vw, 3.75rem);
    font-weight: 600;
    color: var(--lp-purple-deep);
    text-align: center;
    margin-bottom: 3rem;
  }

  .lp-comparison__head {
    display: none;
  }

  @media (min-width: 640px) {
    .lp-comparison__head {
      display: grid;
      grid-template-columns: 1fr 1.2fr 1.2fr;
      gap: 1rem;
      padding-inline: 1.25rem;
      margin-bottom: 0.75rem;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--lp-text-muted);
    }

    .lp-comparison__head-cell--us {
      color: var(--lp-purple);
      padding-left: 0.75rem;
    }
  }

  .lp-comparison__row {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: var(--lp-paper);
    border: 1px solid rgba(59,15,20, 0.05);
    border-radius: var(--lp-radius-card-lg);
    box-shadow: var(--lp-shadow-soft);
    padding: 1.25rem;
    margin-bottom: 0.75rem;
  }

  .lp-comparison__row:last-child {
    margin-bottom: 0;
  }

  @media (min-width: 640px) {
    .lp-comparison__row {
      display: grid;
      grid-template-columns: 1fr 1.2fr 1.2fr;
      gap: 1rem;
      align-items: center;
    }
  }

  .lp-comparison__label {
    font-size: 1rem;
    font-weight: 600;
    color: var(--lp-purple-deep);
  }

  @media (min-width: 1024px) {
    .lp-comparison__label { font-size: 1.125rem; }
  }

  .lp-comparison__cell {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .lp-comparison__cell--us {
    background: rgba(134,27,37, 0.06);
    border-radius: 0.75rem;
    padding: 0.625rem 0.75rem;
  }

  .lp-comparison__minilabel {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--lp-text-muted);
  }

  .lp-comparison__minilabel--us {
    color: var(--lp-purple);
  }

  @media (min-width: 640px) {
    /* Masqué visuellement mais annoncé par les lecteurs d'écran. */
    .lp-comparison__minilabel {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }

  .lp-comparison__value {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .lp-comparison__value--us {
    color: var(--lp-dark);
    font-weight: 600;
  }

  .lp-comparison__value--them {
    color: var(--lp-text-muted);
  }

  .lp-comparison__icon {
    flex-shrink: 0;
    margin-top: 0.125rem;
    display: inline-flex;
  }

  .lp-comparison__icon--us {
    color: var(--lp-purple);
  }

  .lp-comparison__icon--them {
    color: var(--lp-text-muted);
  }
</style>

{%- assign rows = section.blocks | where: 'type', 'row' -%}

<section class="lp-comparison lp-section">
  <div class="lp-container lp-container--narrow">
    <h2 class="lp-comparison__heading" data-lp-reveal="up">{{ section.settings.heading }}</h2>

    {%- if rows.size > 0 -%}
      <div class="lp-comparison__head" aria-hidden="true">
        <span class="lp-comparison__head-cell"></span>
        <span class="lp-comparison__head-cell lp-comparison__head-cell--us">{{ section.settings.col_us }}</span>
        <span class="lp-comparison__head-cell">{{ section.settings.col_them }}</span>
      </div>

      {%- for block in rows -%}
        {%- assign delay = forloop.index0 | modulo: 5 -%}
        <div
          class="lp-comparison__row"
          data-lp-reveal="up"
          {% if delay > 0 %}data-lp-delay="{{ delay }}"{% endif %}
          {{ block.shopify_attributes }}
        >
          <h3 class="lp-comparison__label">{{ block.settings.label }}</h3>

          <div class="lp-comparison__cell lp-comparison__cell--us">
            <span class="lp-comparison__minilabel lp-comparison__minilabel--us">{{ section.settings.col_us }}</span>
            <span class="lp-comparison__value lp-comparison__value--us">
              <span class="lp-comparison__icon lp-comparison__icon--us">
                {%- render 'lp-icon', icon: 'check-circle', size: 18 -%}
              </span>
              {{ block.settings.us_text }}
            </span>
          </div>

          <div class="lp-comparison__cell">
            <span class="lp-comparison__minilabel">{{ section.settings.col_them }}</span>
            <span class="lp-comparison__value lp-comparison__value--them">
              <span class="lp-comparison__icon lp-comparison__icon--them">
                {%- render 'lp-icon', icon: 'x', size: 18 -%}
              </span>
              {{ block.settings.them_text }}
            </span>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "LP — Comparaison",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Gomu vs le reste"
    },
    {
      "type": "text",
      "id": "col_us",
      "label": "En-tête colonne « nous »",
      "default": "Gomu"
    },
    {
      "type": "text",
      "id": "col_them",
      "label": "En-tête colonne « les autres »",
      "default": "Les autres"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Critère",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Critère",
          "default": "Prix mensuel"
        },
        {
          "type": "text",
          "id": "us_text",
          "label": "Colonne « nous »",
          "default": "29€ tout compris"
        },
        {
          "type": "text",
          "id": "them_text",
          "label": "Colonne « les autres »",
          "default": "60–100€ en pots séparés"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "LP — Comparaison",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "label": "Prix mensuel",
            "us_text": "29€ tout compris",
            "them_text": "60–100€ en pots séparés"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Geste quotidien",
            "us_text": "1 sachet, 30 secondes",
            "them_text": "5 pots, de l’eau, un shaker"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Transparence",
            "us_text": "Analyses Eurofins publiées",
            "them_text": "PDF introuvable"
          }
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["page", "product"]
  }
}
{% endschema %}
