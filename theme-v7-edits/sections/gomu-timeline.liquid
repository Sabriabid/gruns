{% render 'gomu-base' %}
<style>
  #gomu-tl-{{ section.id }} { background:var(--cream); padding:0 0 clamp(64px,8vw,116px); }
  #gomu-tl-{{ section.id }} .gt-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:clamp(24px,3vw,52px); align-items:center; }
  #gomu-tl-{{ section.id }} .gt-media { aspect-ratio:1/1; border-radius:26px; overflow:hidden; background:var(--mint); }
  #gomu-tl-{{ section.id }} .gt-media img { width:100%; height:100%; object-fit:cover; display:block; }
  #gomu-tl-{{ section.id }} .gt-col { display:flex; flex-direction:column; gap:clamp(22px,3vw,32px); }
  #gomu-tl-{{ section.id }} .gomu-mono { color:var(--mute); letter-spacing:.22em; }
  #gomu-tl-{{ section.id }} h2 { font-size:clamp(28px,3.2vw,44px); font-weight:800; line-height:1.02; }
  #gomu-tl-{{ section.id }} .gt-row { display:grid; grid-template-columns:92px 1fr; gap:20px; padding:21px 0; border-top:1px solid var(--line); }
  #gomu-tl-{{ section.id }} .gt-row:last-of-type { border-bottom:1px solid var(--line); }
  #gomu-tl-{{ section.id }} .gt-row span { font-family:'DM Mono',monospace; font-size:11px; letter-spacing:.16em; text-transform:uppercase; color:var(--deep); padding-top:3px; }
  #gomu-tl-{{ section.id }} .gt-row p { font-size:15.5px; line-height:1.6; color:var(--ink2); }
  #gomu-tl-{{ section.id }} .gomu-btn { align-self:flex-start; padding:16px 30px; font-size:15.5px; }
  @media (max-width:700px) { #gomu-tl-{{ section.id }} .gt-row { grid-template-columns:1fr; gap:6px; } }
</style>

<section class="gomu" id="gomu-tl-{{ section.id }}">
  <div class="gomu-wrap">
    <div class="gt-grid">
      <div class="gt-media">
        {%- if section.settings.image -%}
          <img src="{{ section.settings.image | image_url: width: 1100 }}" alt="{{ section.settings.image.alt | escape }}" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" loading="lazy">
        {%- endif -%}
      </div>
      <div class="gt-col">
        <div style="display:flex;flex-direction:column;gap:15px">
          {%- if section.settings.eyebrow != blank -%}<span class="gomu-mono">{{ section.settings.eyebrow }}</span>{%- endif -%}
          <h2>{{ section.settings.heading }}</h2>
        </div>
        <div style="display:flex;flex-direction:column">
          {%- for block in section.blocks -%}
            <div class="gt-row" {{ block.shopify_attributes }}>
              <span>{{ block.settings.step }}</span>
              <p>{{ block.settings.text }}</p>
            </div>
          {%- endfor -%}
        </div>
        {%- if section.settings.cta_label != blank -%}
          <a class="gomu-btn gomu-btn--deep" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GOMU timeline",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Your first month" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four weeks to a habit that sticks." },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Start your first month" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "step", "label": "Step label", "default": "Week 1" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "One tear and you're done." }
    ] }
  ],
  "presets": [ { "name": "GOMU timeline", "blocks": [ { "type": "step" }, { "type": "step" }, { "type": "step" } ] } ]
}
{% endschema %}
